msgid "Priority (lower is used first)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/view/mwan4/network/routes.js
msgid "Links with a lower number are used first; links with the same number share the traffic by weight. 1 by default."
msgstr ""

